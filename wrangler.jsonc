{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forms-skelton",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "SITE_NAME": "Skelton Landscape Construction",
    "SITE_DOMAIN": "skelton-landscapes.hlbsolutions.workers.dev",
    "RECIPIENT_EMAIL": "hello@example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-skelton",
      "migrations_dir": "migrations","database_id": "27d7562e-59b7-47a2-a819-9085f79393ed"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "etch-mailer"
    }
  ],
  "ratelimits": [
    {
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
